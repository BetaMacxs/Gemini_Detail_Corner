# ==============================================================================
# Detail Corner Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NETLIFY CLIENT CONFIGURATION (Configure in Netlify Dashboard)
# ------------------------------------------------------------------------------
# Supabase Project Connection (Client-Safe Anon Key)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Frontend Production URL (e.g. https://detailcorner.netlify.app or https://detailcorner.co.za)
VITE_FRONTEND_URL=https://detailcorner.netlify.app

# Optional Client-Side PayFast Fallback (Primary payment handled via Edge Function)
# Set to "true" for testing with PayFast sandbox, "false" for production
VITE_PAYFAST_SANDBOX=true
VITE_PAYFAST_MERCHANT_ID=10000100
VITE_PAYFAST_MERCHANT_KEY=46f0cd694581a
VITE_PAYFAST_NOTIFY_URL=https://your-project-ref.supabase.co/functions/v1/payfast-itn

# Analytics & Conversion Tracking (Optional)
VITE_GA_MEASUREMENT_ID=
VITE_META_PIXEL_ID=


# ------------------------------------------------------------------------------
# 2. SUPABASE EDGE FUNCTION SECRETS (Configure via 'supabase secrets set' or Dashboard)
# DO NOT put these in Netlify client variables or client-facing code.
# ------------------------------------------------------------------------------
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# FRONTEND_URL=https://detailcorner.netlify.app
# PAYFAST_SANDBOX=true
# PAYFAST_MERCHANT_ID=your_merchant_id
# PAYFAST_MERCHANT_KEY=your_merchant_key
# PAYFAST_PASSPHRASE=your_passphrase
# PAYFAST_NOTIFY_URL=https://your-project-ref.supabase.co/functions/v1/payfast-itn
# BREVO_API_KEY=your_brevo_v3_api_key
# FROM_EMAIL=info@detailcorner.co.za
# FROM_NAME="Detail Corner"
# ADMIN_EMAIL=orders@detailcorner.co.za


